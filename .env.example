# ── ClearCondo environment ─────────────────────────────────────────────
# Copy to .env.local for local dev. On Vercel, add these in the dashboard:
# Project → Settings → Environment Variables. NEVER commit real secrets.

# ── Auth (Clerk) ───────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys.
# Without these, the app renders but /app/* shows a setup notice.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── AI (Anthropic) ─────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys. The user holds their own key.
# Without this, /api/analyze/run returns a clear "add your key" state;
# /demo keeps working.
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional override; default is claude-sonnet-4-5-20250929.
ANTHROPIC_MODEL=
# Optional: abort timeout for one Claude analysis call, ms (default 240000).
# The run route gets 300s on Vercel Hobby; this leaves room for verify+persist.
# ANTHROPIC_TIMEOUT_MS=

# ── OCR / extraction tuning (all optional) ─────────────────────────────
# Pages per OCR transcription chunk (default 10), max concurrent chunks
# (default 4), per-chunk abort timeout ms (default 120000), and the
# chars/page below which a page counts as scanned (default 50).
# OCR_CHUNK_PAGES=
# OCR_MAX_CONCURRENCY=
# OCR_CHUNK_TIMEOUT_MS=
# SCAN_TEXT_THRESHOLD_CHARS=

# ── Memory (SurrealDB Cloud) ───────────────────────────────────────────
# https://surrealdb.com/cloud → create an instance, then use its connection
# details. Without these, analyses render ephemerally and are not saved.
SURREAL_URL=wss://<instance-id>.surreal.cloud/rpc
SURREAL_NS=clearcondo
SURREAL_DB=prod
# Use EITHER user/pass (root or a scoped DB user) OR a token:
SURREAL_USER=root
SURREAL_PASS=xxx
# SURREAL_TOKEN=xxx

# ── SurrealDB Agent Memory (belief layer, optional) ───────────────────
# The hosted Agent Memory service (formerly "Spectron"). Each completed
# analysis is remembered as factual text; the service extracts entities,
# reconciles them against prior beliefs, and end-dates superseded facts.
# Without these, the app works exactly as before (tables only).
# Setup: SurrealDB Studio → your org → Contexts → create context →
# API keys → create key. Paste the exact host shown in Studio.
SPECTRON_URL=https://<your-context-host>
SPECTRON_CONTEXT_ID=<your-context-id>
SPECTRON_API_KEY=<redacted>

# ── Data retention ─────────────────────────────────────────────────────
# Raw PDF bytes are never stored (processed in memory only). Extracted page
# text + document rows auto-delete after this many days via a daily Vercel
# Cron hitting /api/retention/cleanup. Reports, flags, facts, and building
# shells are kept until you delete them — see lib/retention.ts for the policy.
# RETENTION_DAYS=30
# Secret for the retention cron. Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>` on cron requests.
# Generate one with: openssl rand -hex 32
# CRON_SECRET=

# ── Payments (Stripe, TEST MODE ONLY) ──────────────────────────────────
# Feature flag: default off → beta-free mode, demo never blocks on payment.
STRIPE_ENABLED=false
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price of one report credit, in cents (default 4900 = $49 CAD).
STRIPE_REPORT_PRICE_CENTS=4900

# ── App URL (for Stripe redirects) ─────────────────────────────────────
# Local: http://localhost:3000 — Vercel sets VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000
