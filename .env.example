# ── ClearCondo environment ─────────────────────────────────────────────
# Copy to .env.local for local dev. On Vercel, add these in the dashboard:
# Project → Settings → Environment Variables. NEVER commit real secrets.

# ── Auth (Clerk) ───────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys.
# Without these, the app renders but /app/* shows a setup notice.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── AI (Anthropic) ─────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys. The user holds their own key.
# Without this, /api/analyze/run returns a clear "add your key" state;
# /demo keeps working.
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional override; default is claude-sonnet-4-5-20250929.
ANTHROPIC_MODEL=

# ── Memory (SurrealDB Cloud) ───────────────────────────────────────────
# https://surrealdb.com/cloud → create an instance, then use its connection
# details. Without these, analyses render ephemerally and are not saved.
SURREAL_URL=wss://<instance-id>.surreal.cloud/rpc
SURREAL_NS=clearcondo
SURREAL_DB=prod
# Use EITHER user/pass (root or a scoped DB user) OR a token:
SURREAL_USER=root
SURREAL_PASS=xxx
# SURREAL_TOKEN=xxx

# ── Payments (Stripe, TEST MODE ONLY) ──────────────────────────────────
# Feature flag: default off → beta-free mode, demo never blocks on payment.
STRIPE_ENABLED=false
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price of one report credit, in cents (default 4900 = $49 CAD).
STRIPE_REPORT_PRICE_CENTS=4900

# ── App URL (for Stripe redirects) ─────────────────────────────────────
# Local: http://localhost:3000 — Vercel sets VERCEL_URL automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000
